# Offline by default. Demo/rule mode performs no paid AI or web calls.
ANALYSIS_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_INTAKE_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=9000
AI_TIMEOUT_MS=90000
AI_INTAKE_TIMEOUT_MS=30000
AI_MATERIAL_TIMEOUT_MS=120000

# No application budget, quota, concurrency gate, Redis or pricing setup required.

# Optional controlled public search. Disabled until its provider is configured.
# q is constructed from server-approved labels; no raw narrative is sent to search.
# This release consumes result snippets only; source pages are not opened.
CONTROLLED_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=

# One user operation = one research round: <=2 literal queries + 1 synthesis.
# Supplement requires a new explicit user operation; no automatic second round.
# Intake is a separate paid request. SDK retries are disabled.
# Analysis shared deadline=270s; route=300s; browser=290s.
# Intake default=30s; route=40s; browser=35s.
# Full case data goes to no-search-tool intake/synthesis only when AI is enabled.
# No server result cache or anonymous usage cookies.
# See docs/research-usage.md for execution diagnostics and search configuration.

# PDF: configured intake model, explicit consent, no Brave dependency or Files objects.
# 1-3 PDFs, 3 MiB/file, 3,900,000 bytes total, 4,000,000 bytes multipart.
# 30 physical pages/case; 75,000 UTF-8 text bytes; no OCR.
# Parser/body=15s each; PDF model=120s (independent of manual intake).
# Total request=180s, route=240s, browser=185s; model output=8,000 tokens.
# Memory-only upload processing; no server result cache or usage cookies.
