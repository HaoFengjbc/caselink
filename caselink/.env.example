# Offline by default. Demo/rule mode performs no paid AI or web calls.
ANALYSIS_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_INTAKE_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=9000
AI_TIMEOUT_MS=90000
AI_INTAKE_TIMEOUT_MS=30000

# REQUIRED before paid mode: shared Redis REST, signing/encryption secret,
# reviewed pricing for every requested/actual model ID and a global daily budget.
# Missing/invalid configuration fails closed; never paste secrets into source.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
USAGE_SESSION_SECRET=
AI_MODEL_RATES_JSON=
AI_GLOBAL_DAILY_BUDGET_USD=
AI_SESSION_DAILY_REQUESTS=10
AI_IP_DAILY_REQUESTS=30
AI_GLOBAL_CONCURRENCY=3
AI_SESSION_CONCURRENCY=1
# Vercel uses the platform-overwritten x-vercel-forwarded-for header.
# Other deployments must set a header overwritten by their trusted reverse proxy.
# Do not trust a header that clients can set or append.
USAGE_TRUSTED_IP_HEADER=

# Optional controlled public search. Disabled until provider and cost are set.
# q is constructed from server-approved labels; no raw narrative is sent to search.
# This release consumes result snippets only; source pages are not opened.
CONTROLLED_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_MAX_COST_USD=

# One user operation = one research round: <=2 literal queries + 1 synthesis.
# Supplement requires a new explicit user operation; no automatic second round.
# Intake is a separate paid request. SDK retries are disabled.
# Analysis shared deadline=270s; route=300s; browser=290s.
# Intake default=30s; route=40s; browser=35s.
# Full case data goes to no-search-tool intake/synthesis only when AI is enabled.
# Ordinary manual-case encrypted results expire after 120s and are session-scoped.
# PDF extraction and analysis containing uploaded materials do not cache result contents.
# See docs/research-usage.md for rates JSON shape, retention and integration gates.

# PDF material intake uses OPENAI_INTAKE_MODEL and the same usage guard above.
# No Brave/search key is required for extraction. No separate PDF provider/key.
# Its conservative reservation uses 8,000 max output tokens plus the shared input bound.
# Site limits are fixed in MATERIAL_LIMITS, below the Vercel request-body ceiling:
# 1-3 files, 3 MiB/file, 3,900,000 bytes/file sum, 4,000,000 bytes/multipart,
# 30 physical pages/case, 75,000 UTF-8 text bytes per extraction.
# No OCR in this version. Default server/file storage is memory only.

# PDF request deadline=55s; route=60s; browser=60s; parser/body-read cap=15s.
# Temporary upload data stays in process/browser memory. No Files API objects.
